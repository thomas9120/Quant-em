    {
      "pattern": "^blk\\.\\d+\\.attn_q\\.weight$",
      "type": "Q8_0"
    },
    {
      "pattern": "^blk\\.\\d+\\.attn_k\\.weight$",
      "type": "Q8_0"
    }
  ]
}
