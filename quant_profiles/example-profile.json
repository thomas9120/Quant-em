{
  "profileVersion": 1,
  "name": "Example Mixed Tensor Profile",
  "description": "Small example profile showing per-tensor regex overrides.",
  "source": {
    "kind": "manual"
  },
  "baseQuantType": "Q4_K_M",
  "tokenEmbeddingType": "Q8_0",
